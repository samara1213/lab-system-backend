# Copiar a .env y completar. Nunca commitear valores reales.
PORT=3000

# Base de datos PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=

# Autenticacion
JWT_SECRET=

# Seguridad HTTP
# Origenes del frontend permitidos por CORS, separados por coma (si se deja vacio, CORS queda abierto).
# El primero tambien arma el enlace del correo de recuperacion de contraseña (<url>/reset-password?token=...)
FRONTEND_URL=
# Saltos de proxy de confianza para obtener la IP real del cliente (Railway: 1)
TRUST_PROXY=1

# Correo (Nodemailer)
SERVICE_NOTIFICATION=
USER_NOTIFICATION=
PASSWORD_NOTIFICATION=

# Supabase Storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=
